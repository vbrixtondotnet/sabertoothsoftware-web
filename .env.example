# Copy to `.env.local` (gitignored). Run `npm run setup:email` after `wrangler login`.

FROM_EMAIL=marketing@sabertoothsoftwarelabs.net
CONTACT_EMAIL=marketing@sabertoothsoftwarelabs.net
CAREERS_EMAIL=admin@sabertoothsoftwarelabs.net
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# CLOUDFLARE_EMAIL_API_TOKEN is written to `.dev.vars` by setup:email (wrangler OAuth).
# For production, use a long-lived API token with Email Sending → Send:
#   Dashboard → My Profile → API Tokens, then:
#   npx wrangler pages secret bulk .dev.vars --project-name=sabertooth-software-labs
